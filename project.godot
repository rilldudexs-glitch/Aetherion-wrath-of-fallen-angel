; AETHERION: Wrath of the Fallen
; Godot 4 project foundation

config_version=5

[application]
config/name="AETHERION: Wrath of the Fallen"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.06, 1)

[physics]
3d/default_gravity=9.8

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}

light_attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
heavy_attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

lock_on={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

switch_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
